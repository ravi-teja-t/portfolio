{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-images.mjs && next build && node scripts/strip-not-found-scripts.mjs && node scripts/check-built-output.mjs",
    "lint": "eslint",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:checks": "node --test --test-concurrency=1 tests/checks/",
    "test:e2e": "node tests/build-fixtures.mjs && playwright test",
    "test:lighthouse": "node tests/run-lighthouse.mjs",
    "images": "node scripts/generate-images.mjs",
    "site:deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.9.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
